# Plaid production credentials (set these in Vercel, never commit real values)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production

# Exact HTTPS URL registered in Plaid Dashboard, normally the app root.
# Example: https://your-project.vercel.app/
PLAID_REDIRECT_URI=

# Neon Postgres connection string. Vercel's Neon integration usually adds this.
DATABASE_URL=

# Required owner sign-in. Use a long private passphrase.
OWNER_PASSWORD=

# Optional. If omitted, the app derives a signing key from OWNER_PASSWORD.
SESSION_SECRET=

# Optional. If omitted, Plaid tokens are encrypted using a key derived from PLAID_SECRET.
TOKEN_ENCRYPTION_KEY=

# Optional. The default production endpoint is https://api.clover.com.
CLOVER_API_HOST=https://api.clover.com

# Existing Taco Miami Clover credentials. On first use, the app imports these
# into the encrypted clover_merchants database table without exposing them.
CLOVER_SHELL_MERCHANT_ID=
CLOVER_SHELL_ACCESS_TOKEN=
CLOVER_ORIGINAL_MERCHANT_ID=
CLOVER_ORIGINAL_ACCESS_TOKEN=
